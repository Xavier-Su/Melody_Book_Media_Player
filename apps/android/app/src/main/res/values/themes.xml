<resources>
    <!-- Compose 负责真正的界面主题，这里只提供窗口级的基础主题 -->
    <style name="Theme.MelodyBook" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_bg</item>
    </style>

    <style name="Theme.MelodyBook.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_teal</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MelodyBook</item>
    </style>
</resources>
